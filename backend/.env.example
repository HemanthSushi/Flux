# Copy this file to `.env` and fill your values.

DJANGO_SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=*

# Database
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# For PostgreSQL, uncomment and fill:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=your_db_name
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_HOST=your_db_host
# DB_PORT=5432

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com
FRONTEND_BASE_URL=http://127.0.0.1:5173

# AI categorization + OCR
AI_MODEL_RETRAIN_HOURS=24
AI_RETRAIN_FEEDBACK_THRESHOLD=10
AI_CATEGORY_FEEDBACK_THRESHOLD=0.65
AI_RECEIPT_MAX_UPLOAD_MB=8
TESSERACT_CMD=

# Security controls
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
EMAIL_VERIFICATION_OTP_TTL_MINUTES=10
EMAIL_VERIFICATION_OTP_MAX_ATTEMPTS=5

# DRF rate limits
DRF_ANON_RATE=120/hour
DRF_USER_RATE=2000/day
DRF_LOGIN_RATE=10/min
DRF_REGISTER_RATE=20/hour
DRF_PASSWORD_RESET_RATE=8/hour
DRF_PASSWORD_CHANGE_RATE=15/hour
DRF_EMAIL_VERIFY_RATE=10/hour
